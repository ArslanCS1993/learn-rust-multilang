{
  "buildCommand": "echo 'No build needed'",
  "outputDirectory": "public",
  "framework": "none",
  "rewrites": [
    {
      "source": "/src/(.*)",
      "destination": "/src/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}